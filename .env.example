# HK-AICOS 環境變數範本
# 複製此檔案為 .env 並填入真實 API Key
# 切勿將 .env 提交到 Git

# 分析服務 API Key（二選一）
# 優先使用 Anthropic（支援圖片分析）
ANTHROPIC_API_KEY=

# DeepSeek（只支援文字分析，不支援圖片）
DEEPSEEK_API_KEY=

# Optional structured Q&A provider
OPENAI_API_KEY=your_openai_api_key_here
GEMINI_API_KEY=
AICOS_LLM_PROVIDER=anthropic
# AICOS_LLM_MODEL=provider_model_name

# Optional web search providers (configure one; no key means honest local fallback)
TAVILY_API_KEY=
BRAVE_SEARCH_API_KEY=
SERPAPI_API_KEY=your_serpapi_api_key_here
GOOGLE_CSE_ID=your_google_custom_search_engine_id_here
GOOGLE_API_KEY=your_google_api_key_here

# 管理員模式（預設關閉）
# ADMIN_MODE=false
